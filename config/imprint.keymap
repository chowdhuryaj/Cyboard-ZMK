#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <scroll-snap.dtsi>
#include <behaviors.dtsi>
#include <behaviors/input_gestures_accel.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define L_BASE    0
#define L_CONTROL 1
#define L_FN      2
#define L_MOUSE   3
#define L_SNIPE   4
#define L_MAC     5

/* OS shortcut flavor for combos & adaptive keys (compile-time for now).
 * The MAC toggle layer (control + right inner thumb) swaps nav/word arrows at
 * runtime; combos can't be OS-switched natively — that lands with the
 * Phase-1 os-shortcuts module. Default: PC (ctrl). Uncomment for mac flavor.
 */
// #define FLASK_OS_MAC
#ifdef FLASK_OS_MAC
#define OSK(k) LG(k) /* clipboard-style shortcuts: cmd on mac */
#define OSW(k) LA(k) /* word nav/delete: opt on mac */
#else
#define OSK(k) LC(k)
#define OSW(k) LC(k)
#endif

&mt {
    quick-tap-ms = <150>;
    flavor = "tap-preferred";
};

&sl { lazy; };

/ {
    chosen { zmk,matrix-transform = &imprint_number_row_full_bottom_row; };

    behaviors {
        hm_l_ctrl: hm_l_ctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L_CTRL";
            #binding-cells = <2>;
            bindings = <&ctrl_rgb>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 53 54 55 56 57 61 62 63 67 68 69>;
        };

        hm_l_alt: hm_l_alt {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L_ALT";
            #binding-cells = <2>;
            bindings = <&alt_rgb>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 53 54 55 56 57 61 62 63 67 68 69>;
        };

        hm_l_gui: hm_l_gui {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L_GUI";
            #binding-cells = <2>;
            bindings = <&gui_rgb>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 53 54 55 56 57 61 62 63 67 68 69>;
            hold-trigger-on-release;
        };

        hm_l_shft: hm_l_shft {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L_SHFT";
            #binding-cells = <2>;
            bindings = <&shft_rgb>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 53 54 55 56 57 61 62 63 67 68 69>;
        };

        ak_rti: ak_rti {
            compatible = "zmk,behavior-adaptive-key";
            label = "AK_RTI";
            #binding-cells = <0>;
            bindings = <&key_repeat>;

            rti_a {
                trigger-keys = <A>;
                max-prior-idle-ms = <500>;
                bindings = <&kp O>;
            };

            rti_b {
                trigger-keys = <B>;
                max-prior-idle-ms = <500>;
                bindings = <&kp E &kp C &kp A &kp U &kp S &kp E>;
            };

            rti_e {
                trigger-keys = <E>;
                max-prior-idle-ms = <500>;
                bindings = <&kp U>;
            };

            rti_g {
                trigger-keys = <G>;
                max-prior-idle-ms = <500>;
                bindings = <&kp I &kp N &kp G>;
            };

            rti_h {
                trigger-keys = <H>;
                max-prior-idle-ms = <500>;
                bindings = <&kp I &kp C &kp H>;
            };

            rti_i {
                trigger-keys = <I>;
                max-prior-idle-ms = <500>;
                bindings = <&kp N &kp G>;
            };

            rti_j {
                trigger-keys = <J>;
                max-prior-idle-ms = <500>;
                bindings = <&kp U &kp S &kp T>;
            };

            rti_k {
                trigger-keys = <K>;
                max-prior-idle-ms = <500>;
                bindings = <&kp I &kp N &kp G>;
            };

            rti_l {
                trigger-keys = <L>;
                max-prior-idle-ms = <500>;
                bindings = <&kp O &kp N &kp G>;
            };

            rti_m {
                trigger-keys = <M>;
                max-prior-idle-ms = <500>;
                bindings = <&kp E &kp N &kp T>;
            };

            rti_n {
                trigger-keys = <N>;
                max-prior-idle-ms = <500>;
                bindings = <&kp I &kp O &kp N>;
            };

            rti_o {
                trigger-keys = <O>;
                max-prior-idle-ms = <500>;
                bindings = <&kp U &kp L &kp D>;
            };

            rti_p {
                trigger-keys = <P>;
                max-prior-idle-ms = <500>;
                bindings = <&kp E &kp O &kp P &kp L &kp E>;
            };

            rti_q {
                trigger-keys = <Q>;
                max-prior-idle-ms = <500>;
                bindings = <&kp U>;
            };

            rti_t {
                trigger-keys = <T>;
                max-prior-idle-ms = <500>;
                bindings = <&kp I &kp O &kp N>;
            };

            rti_u {
                trigger-keys = <U>;
                max-prior-idle-ms = <500>;
                bindings = <&kp I>;
            };

            rti_v {
                trigger-keys = <V>;
                max-prior-idle-ms = <500>;
                bindings = <&kp S>;
            };

            rti_y {
                trigger-keys = <Y>;
                max-prior-idle-ms = <500>;
                bindings = <&kp O &kp U>;
            };

            rti_space {
                trigger-keys = <SPACE>;
                max-prior-idle-ms = <500>;
                bindings = <&kp T &kp H &kp E>;
            };

            rti_sentence {
                trigger-keys = <DOT QMARK EXCL>;
                max-prior-idle-ms = <500>;
                bindings = <&kp SPACE &sk LSHFT>;
            };

            rti_bspc {
                trigger-keys = <BSPC>;
                max-prior-idle-ms = <500>;
                bindings = <&kp OSW(BSPC)>;
            };

            rti_del {
                trigger-keys = <DEL>;
                max-prior-idle-ms = <500>;
                bindings = <&kp OSW(DEL)>;
            };
        };

        as_ht: as_ht {
            compatible = "zmk,behavior-hold-tap";
            label = "AS_HT";
            bindings = <&shift>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        bdel: bdel {
            compatible = "zmk,behavior-mod-morph";
            label = "BDEL";
            bindings = <&kp BSPC>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_RCTL|MOD_LGUI|MOD_RALT|MOD_RGUI)>;
        };

        th_r_rep: th_r_rep {
            compatible = "zmk,behavior-hold-tap";
            label = "TH_R_REP";
            bindings = <&alt_rgb>, <&key_repeat>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "hold-preferred";
            quick-tap-ms = <150>;
            require-prior-idle-ms = <165>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 58 59 60 64 65 66>;
        };

        hm_r_ctrl: hm_r_ctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_R_CTRL";
            #binding-cells = <2>;
            bindings = <&ctrl_rgb>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 58 59 60 64 65 66>;
        };

        hm_r_gui: hm_r_gui {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_R_GUI";
            #binding-cells = <2>;
            bindings = <&gui_rgb>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 58 59 60 64 65 66>;
        };

        hm_r_shift: hm_r_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_R_SHIFT";
            #binding-cells = <2>;
            bindings = <&shft_rgb>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 58 59 60 64 65 66>;
        };

        sl_mo: sl_mo {
            compatible = "zmk,behavior-hold-tap";
            label = "SL_MO";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
        };

        leader: leader {
            compatible = "zmk,behavior-leader-key";
            label = "LEADER";
            #binding-cells = <0>;

            email {
                sequence = <E M>;
                bindings = <&email_um>;
            };

            to_usb {
                sequence = <U>;
                bindings = <&out OUT_USB>;
            };

            to_ble {
                sequence = <B>;
                bindings = <&out OUT_BLE>;
            };
        };
    };

    combos {
        compatible = "zmk,combos";

        copy_cut {
            bindings = <&mt OSK(X) OSK(C)>;
            key-positions = <27 26>;
            timeout-ms = <35>;
            require-prior-idle-ms = <150>;
        };

        lbtab {
            bindings = <&kp LS(TAB)>;
            key-positions = <26 14>;
            timeout-ms = <35>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <27 15>;
            timeout-ms = <35>;
        };

        lesc {
            bindings = <&kp ESC>;
            key-positions = <13 25>;
            timeout-ms = <35>;
        };

        paste {
            bindings = <&kp OSK(V)>;
            key-positions = <28 27>;
            timeout-ms = <35>;
            require-prior-idle-ms = <150>;
        };

        undo_redo {
            bindings = <&mt OSK(Y) OSK(Z)>;
            key-positions = <26 25>;
            timeout-ms = <35>;
            require-prior-idle-ms = <150>;
        };

        sel_all {
            bindings = <&kp OSK(A)>;
            key-positions = <29 17>;
            timeout-ms = <35>;
            require-prior-idle-ms = <140>;
        };

        ent {
            bindings = <&kp ENTER>;
            key-positions = <16 28>;
            timeout-ms = <35>;
        };

        close {
            bindings = <&kp OSK(W)>;
            key-positions = <28 40>;
            timeout-ms = <35>;
        };

        ntab {
            bindings = <&kp OSK(T)>;
            key-positions = <27 39>;
            timeout-ms = <35>;
        };

        quit {
            bindings = <&kp LG(Q)>;
            key-positions = <25 37>;
            timeout-ms = <35>;
        };

        rbtab {
            bindings = <&kp LS(TAB)>;
            key-positions = <21 33>;
            timeout-ms = <35>;
        };

        rtab {
            bindings = <&kp TAB>;
            key-positions = <20 32>;
            timeout-ms = <35>;
        };

        resc {
            bindings = <&kp ESC>;
            key-positions = <22 34>;
            timeout-ms = <35>;
        };

        rent {
            bindings = <&kp ENTER>;
            key-positions = <19 31>;
            timeout-ms = <35>;
        };

        excl {
            bindings = <&kp EXCL>;
            key-positions = <18 19>;
            timeout-ms = <35>;
            layers = <0>;
        };

        dot {
            bindings = <&kp DOT>;
            key-positions = <30 31>;
            timeout-ms = <35>;
        };

        comma {
            bindings = <&kp COMMA>;
            key-positions = <42 43>;
            timeout-ms = <35>;
        };

        semi {
            bindings = <&kp SEMI>;
            key-positions = <42 30>;
            timeout-ms = <35>;
        };

        quote {
            bindings = <&kp SQT>;
            key-positions = <32 44>;
            timeout-ms = <35>;
        };

        fslhq {
            bindings = <&kp FSLH>;
            key-positions = <31 43>;
            timeout-ms = <35>;
        };

        lbkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <33 45>;
            timeout-ms = <35>;
        };

        rbkt {
            bindings = <&kp RBKT>;
            key-positions = <34 46>;
            timeout-ms = <35>;
        };

        m4 {
            bindings = <&mkp MB4>;
            key-positions = <51 50>;
            timeout-ms = <35>;
        };

        m5 {
            bindings = <&mkp MB5>;
            key-positions = <52 51>;
            timeout-ms = <35>;
        };

        z {
            bindings = <&lt 1 Z>;
            key-positions = <58 64>;
            timeout-ms = <35>;
        };

        x {
            bindings = <&lt 2 X>;
            key-positions = <59 65>;
            timeout-ms = <35>;
        };

        rrep {
            bindings = <&key_repeat>;
            key-positions = <63 69>;
            timeout-ms = <35>;
        };
    };

    macros {
        shift: shift {
            compatible = "zmk,behavior-macro-one-param";
            label = "SHIFT";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        as: as {
            compatible = "zmk,behavior-macro-one-param";
            label = "AS";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        };

        ctrl_rgb: ctrl_rgb {
            compatible = "zmk,behavior-macro-one-param";
            label = "CTRL_RGB";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&rgb_ug RGB_ON &rgb_ug RGB_COLOR_HSB(167,62,40)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&rgb_ug RGB_OFF>;
        };

        alt_rgb: alt_rgb {
            compatible = "zmk,behavior-macro-one-param";
            label = "ALT_RGB";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&rgb_ug RGB_ON &rgb_ug RGB_COLOR_HSB(19,100,66)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&rgb_ug RGB_OFF>;
        };

        gui_rgb: gui_rgb {
            compatible = "zmk,behavior-macro-one-param";
            label = "GUI_RGB";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&rgb_ug RGB_ON &rgb_ug RGB_COLOR_HSB(269,87,47)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&rgb_ug RGB_OFF>;
        };

        shft_rgb: shft_rgb {
            compatible = "zmk,behavior-macro-one-param";
            label = "SHFT_RGB";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&rgb_ug RGB_ON &rgb_ug RGB_COLOR_HSB(93,100,50)>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&rgb_ug RGB_OFF>;
        };

        rgb_cont: rgb_cont {
            compatible = "zmk,behavior-macro";
            label = "RGB_CONT";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_ON &rgb_ug RGB_COLOR_HSB(0,25,94)>;
        };

        rgb_fn: rgb_fn {
            compatible = "zmk,behavior-macro";
            label = "RGB_FN";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_ON &rgb_ug RGB_COLOR_HSB(50,100,39)>;
        };

        qu: qu {
            compatible = "zmk,behavior-macro";
            label = "QU";
            #binding-cells = <0>;
            bindings = <&kp Q &kp U>;
        };

        email_um: email_um {
            compatible = "zmk,behavior-macro";
            label = "EMAIL_UM";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp C &kp H &kp O &kp W &kp D &kp N1 &kp N9 &kp N8 &kp AT &kp U &kp M &kp N &kp DOT &kp E &kp D &kp U>;
        };
    };

    layer_listeners {
        compatible = "zmk,layer-listeners";

        control_rgb_listener {
            layers = <1>;
            bindings = <&rgb_cont &rgb_ug RGB_OFF>;
        };

        fn_rgb_listener {
            layers = <2>;
            bindings = <&rgb_fn &rgb_ug RGB_OFF>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&trans  &as N1   &as N2   &as N3   &as N4              &as N5                              &as N6    &as N7                   &as N8               &as N9                   &as N0               &trans
&trans  &kp Q    &kp W    &kp E    &kp R               &kp T                               &kp Y     &kp U                    &kp I                &kp O                    &kp P                &trans
&trans  &kp A    &kp S    &kp D    &kp F               &kp G                               &kp H     &kp J                    &kp K                &kp L                    &kp SEMI             &kp SQT
&trans  &kp Z    &kp X    &kp C    &kp V               &kp B                               &kp N     &kp M                    &kp COMMA            &kp DOT                  &kp FSLH             &kp LS(RPAR)
&trans  &kp F20  &kp F11  &kp F12  &kp GRAVE                                                         &mt HOME DOWN_ARROW      &mt END UP           &mt LC(LEFT) LEFT_ARROW  &mt LC(RIGHT) RIGHT  &trans
                                   &hm_l_gui LGUI H    &hm_l_shft LSHFT SPACE  &mkp MB1    &mkp MB1  &hm_r_shift RSHFT SPACE  &hm_r_gui RGUI L
                                   &hm_l_shft LCTRL T  &hm_l_ctrl LCTRL BSPC   &mkp MB2    &mkp MB3  &hm_r_ctrl RCTRL DEL     &hm_r_shift RSHFT R
            >;
        };

        control {
            bindings = <
&bootloader  &trans        &trans    &trans        &trans     &trans                        &trans          &trans          &trans           &trans           &trans           &trans
&trans       &kp C_VOL_UP  &kp HOME  &kp UP        &kp END    &trans                        &trans          &trans          &kp LS(TAB)      &kp UP           &kp TAB          &trans
&trans       &kp C_VOL_DN  &kp LEFT  &kp DOWN      &kp RIGHT  &leader                       &caps_word      &kp RET         &kp LEFT         &kp DOWN         &kp RIGHT        &kp ESC
&trans       &kp C_MUTE    &kp C_PP  &kp C_REWIND  &kp C_FF   &trans                        &trans          &rgb_ug RGB_ON  &rgb_ug RGB_OFF  &rgb_ug RGB_EFR  &rgb_ug RGB_EFF  &trans
&trans       &trans        &trans    &trans        &trans                                                   &trans          &trans           &trans           &trans           &trans
                                                   &trans     &bt BT_SEL 0  &bt BT_SEL 1    &tog L_MAC      &sys_reset      &bt BT_CLR
                                                   &trans     &bt BT_SEL 2  &bt BT_SEL 3    &studio_unlock  &trans          &trans
            >;
        };

        fn {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans             &trans   &trans   &trans   &trans   &trans   &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &kp F13            &trans   &trans   &trans   &trans   &trans   &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &kp F14            &kp F16  &kp F17  &kp F18  &kp F19  &kp F20  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &kp F15            &kp F21  &kp F22  &kp F23  &kp F24  &none    &trans
&none   &trans  &trans   &trans   &trans                               &trans   &trans   &trans   &trans   &trans
                                  &trans   &trans   &none     &trans   &trans   &trans
                                  &trans   &trans   &trans    &trans   &trans   &trans
            >;
        };

        /* Auto-mouse overlay (Flask MBO): popped by cursor-ball motion via
         * zip_temp_layer, drops 500 ms after last motion. Home-row clicks on
         * both hands; hold A-position for snipe. Thumb MB1/2/3 stay via &trans. */
        mouse {
            bindings = <
&trans  &trans       &trans  &trans    &trans    &trans      &trans    &trans    &trans    &trans  &trans  &trans
&trans  &trans       &trans  &trans    &trans    &trans      &trans    &trans    &trans    &trans  &trans  &trans
&trans  &mo L_SNIPE  &trans  &mkp MB2  &mkp MB1  &mkp MB3    &mkp MB3  &mkp MB1  &mkp MB2  &trans  &trans  &trans
&trans  &trans       &trans  &trans    &trans    &trans      &trans    &trans    &trans    &trans  &trans  &trans
&trans  &trans       &trans  &trans    &trans                          &trans    &trans    &trans  &trans  &trans
                                       &trans    &trans    &trans    &trans    &trans    &trans
                                       &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };

        /* Snipe: transparent — exists to gate the 1/3 cursor scaler in the
         * peripheral listener (Flask sniper). */
        snipe {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        /* Mac overlay (toggle: control + right inner thumb): swaps the nav row
         * to mac idioms — Home/End -> cmd+arrow, word-jump -> opt+arrow.
         * Combos keep the compile-time OSK() flavor until the Phase-1
         * os-shortcuts module brings runtime switching. */
        mac {
            bindings = <
&trans  &trans  &trans  &trans  &trans           &trans                    &trans  &trans               &trans              &trans               &trans                &trans
&trans  &trans  &trans  &trans  &trans           &trans                    &trans  &trans               &trans              &trans               &trans                &trans
&trans  &trans  &trans  &trans  &trans           &trans                    &trans  &trans               &trans              &trans               &trans                &trans
&trans  &trans  &trans  &trans  &trans           &trans                    &trans  &trans               &trans              &trans               &trans                &trans
&trans  &trans  &trans  &trans  &trans                                             &mt LG(LEFT) DOWN_ARROW  &mt LG(RIGHT) UP  &mt LA(LEFT) LEFT_ARROW  &mt LA(RIGHT) RIGHT  &trans
                                &trans           &trans  &trans    &trans  &trans  &trans
                                &trans           &trans  &trans    &trans  &trans  &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};

/* Auto-mouse layer processor: don't pop the layer mid-typing (150 ms idle gate,
 * matches HRM require-prior-idle), and don't drop it when clicking — excluded
 * positions are the mouse-layer click keys (25 27 28 29 30 31 32) plus the
 * always-on thumb mouse buttons (60 61 66 67). */
&zip_temp_layer {
    require-prior-idle-ms = <150>;
    excluded-positions = <25 27 28 29 30 31 32 60 61 66 67>;
};

/* Flask-flavored accel (maccel curve: precision floor 0.2x at crawl speed,
 * native 1.0x once moving). Opt-in like Flask — configured but not in the
 * chain; uncomment &pointer_accel below to enable. */
&pointer_accel {
    input-type = <INPUT_EV_REL>;
    track-remainders;
    min-factor = <200>;
    max-factor = <1000>;
    speed-threshold = <1200>;
    speed-max = <6000>;
    acceleration-exponent = <2>;
};

/* Right ball = cursor. Motion pops the auto-mouse layer (Flask MBO, 400 ms —
 * AJ's live Svalboard setting, dumped 2026-07-07, see
 * docs/flask-svalboard-dump.json); snipe layer scales 1/3 on top of the base
 * chain. */
&trackball_peripheral_listener {
    input-processors = <
        &zip_xy_scaler 1 1
        &zip_temp_layer L_MOUSE 400
        // &pointer_accel
    >;

    snipe {
        layers = <L_SNIPE>;
        input-processors = <&zip_xy_scaler 1 3>;
        process-next;
    };
};

&trackball_central_listener {
    input-processors = <
        &zip_x_scaler 1 16
        &zip_y_scaler 1 12
        &zip_xy_to_scroll_mapper
        &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
        &zip_scroll_snap
    >;
};
