#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <flask_scrollsnap.dtsi>
#include <flask_accel.dtsi>
#include <flask_automouse.dtsi>
#include <flask_autoscroll.dtsi>
#include <dt-bindings/flask/autoscroll.h>
#include <flask_rgb.dtsi>
#include <dt-bindings/flask/rgb.h>
#include <flask_gestures.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk-switch-layout/switch-layout.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define L_BASE    0
#define L_CONTROL 1
#define L_FN      2
#define L_MOUSE   3
#define L_SNIPE   4
#define L_NUM     5

/* OS mode = switch-layout index (mctechnology17/zmk-switch-layout), stored in
 * settings so it survives reboot/reflash. slk_* behaviors below pick the
 * right chord per OS; &sw_layout OS_NEXT (control + right inner thumb)
 * toggles. */
#define OS_PC  0
#define OS_MAC 1
#define OS_NEXT ZMK_SWITCH_LAYOUT_NEXT

&mt {
    quick-tap-ms = <150>;
    flavor = "tap-preferred";
};

/* (&sl's `lazy` override removed 2026-07-11 — it deferred layer activation
 * until the next key, which read as "HUD doesn't follow the layer" on the
 * bench, and a lazy sticky layer inside the smart_layer hold-tap was the
 * strongest suspect for the 2026-07-10 crash. smart_layer now wraps the
 * dedicated non-lazy &skl below; nothing else binds &sl.) */

/ {
    /* Physical layout (carries the same matrix transform) — required for
     * ZMK Studio; geometry generated from config/info.json. */
    chosen { zmk,physical-layout = &imprint_physical_layout; };

    behaviors {
        hm_l_ctrl: hm_l_ctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L_CTRL";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 53 54 55 56 57 61 62 63 67 68 69>;
        };

        hm_l_alt: hm_l_alt {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L_ALT";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 53 54 55 56 57 61 62 63 67 68 69>;
        };

        hm_l_gui: hm_l_gui {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L_GUI";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 53 54 55 56 57 61 62 63 67 68 69>;
            hold-trigger-on-release;
        };

        hm_l_shft: hm_l_shft {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L_SHFT";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 53 54 55 56 57 61 62 63 67 68 69>;
        };

        ak_rti: ak_rti {
            compatible = "zmk,behavior-adaptive-key";
            label = "AK_RTI";
            #binding-cells = <0>;
            bindings = <&key_repeat>;

            rti_a {
                trigger-keys = <A>;
                max-prior-idle-ms = <500>;
                bindings = <&kp O>;
            };

            rti_b {
                trigger-keys = <B>;
                max-prior-idle-ms = <500>;
                bindings = <&kp E &kp C &kp A &kp U &kp S &kp E>;
            };

            rti_e {
                trigger-keys = <E>;
                max-prior-idle-ms = <500>;
                bindings = <&kp U>;
            };

            rti_g {
                trigger-keys = <G>;
                max-prior-idle-ms = <500>;
                bindings = <&kp I &kp N &kp G>;
            };

            rti_h {
                trigger-keys = <H>;
                max-prior-idle-ms = <500>;
                bindings = <&kp I &kp C &kp H>;
            };

            rti_i {
                trigger-keys = <I>;
                max-prior-idle-ms = <500>;
                bindings = <&kp N &kp G>;
            };

            rti_j {
                trigger-keys = <J>;
                max-prior-idle-ms = <500>;
                bindings = <&kp U &kp S &kp T>;
            };

            rti_k {
                trigger-keys = <K>;
                max-prior-idle-ms = <500>;
                bindings = <&kp I &kp N &kp G>;
            };

            rti_l {
                trigger-keys = <L>;
                max-prior-idle-ms = <500>;
                bindings = <&kp O &kp N &kp G>;
            };

            rti_m {
                trigger-keys = <M>;
                max-prior-idle-ms = <500>;
                bindings = <&kp E &kp N &kp T>;
            };

            rti_n {
                trigger-keys = <N>;
                max-prior-idle-ms = <500>;
                bindings = <&kp I &kp O &kp N>;
            };

            rti_o {
                trigger-keys = <O>;
                max-prior-idle-ms = <500>;
                bindings = <&kp U &kp L &kp D>;
            };

            rti_p {
                trigger-keys = <P>;
                max-prior-idle-ms = <500>;
                bindings = <&kp E &kp O &kp P &kp L &kp E>;
            };

            rti_q {
                trigger-keys = <Q>;
                max-prior-idle-ms = <500>;
                bindings = <&kp U>;
            };

            rti_t {
                trigger-keys = <T>;
                max-prior-idle-ms = <500>;
                bindings = <&kp I &kp O &kp N>;
            };

            rti_u {
                trigger-keys = <U>;
                max-prior-idle-ms = <500>;
                bindings = <&kp I>;
            };

            rti_v {
                trigger-keys = <V>;
                max-prior-idle-ms = <500>;
                bindings = <&kp S>;
            };

            rti_y {
                trigger-keys = <Y>;
                max-prior-idle-ms = <500>;
                bindings = <&kp O &kp U>;
            };

            rti_space {
                trigger-keys = <SPACE>;
                max-prior-idle-ms = <500>;
                bindings = <&kp T &kp H &kp E>;
            };

            rti_sentence {
                trigger-keys = <DOT QMARK EXCL>;
                max-prior-idle-ms = <500>;
                bindings = <&kp SPACE &sk LSHFT>;
            };

            rti_bspc {
                trigger-keys = <BSPC>;
                max-prior-idle-ms = <500>;
                bindings = <&slk_wbspc>;
            };

            rti_del {
                trigger-keys = <DEL>;
                max-prior-idle-ms = <500>;
                bindings = <&slk_wdel>;
            };
        };

        /* Second adaptive key (urob/zmk-adaptive-key): the QMK Alt Repeat —
         * taps the REVERSE companion of the last key (→ after ←, PgDn after
         * PgUp, ⇧Tab after Tab, closing bracket after opening). No
         * max-prior-idle: works whenever. Falls back to plain repeat. More
         * of these can coexist (ak_rti = completions, ak_alt = reversals). */
        ak_alt: ak_alt {
            compatible = "zmk,behavior-adaptive-key";
            label = "AK_ALT";
            #binding-cells = <0>;
            bindings = <&key_repeat>;

            alt_left    { trigger-keys = <LEFT>;  bindings = <&kp RIGHT>; };
            alt_right   { trigger-keys = <RIGHT>; bindings = <&kp LEFT>; };
            alt_up      { trigger-keys = <UP>;    bindings = <&kp DOWN>; };
            alt_down    { trigger-keys = <DOWN>;  bindings = <&kp UP>; };
            alt_pgup    { trigger-keys = <PG_UP>; bindings = <&kp PG_DN>; };
            alt_pgdn    { trigger-keys = <PG_DN>; bindings = <&kp PG_UP>; };
            alt_home    { trigger-keys = <HOME>;  bindings = <&kp END>; };
            alt_end     { trigger-keys = <END>;   bindings = <&kp HOME>; };
            alt_tab     { trigger-keys = <TAB>;   bindings = <&kp LS(TAB)>; };
            alt_lbkt    { trigger-keys = <LBKT>;  bindings = <&kp RBKT>; };
            alt_rbkt    { trigger-keys = <RBKT>;  bindings = <&kp LBKT>; };
        };

        /* Smart num layer (urob/zmk-auto-layer): &num_word L_NUM latches the
         * num layer; digits and the continue-list keep it alive, anything
         * else drops back. */
        num_word: num_word {
            compatible = "zmk,behavior-auto-layer";
            #binding-cells = <1>;
            continue-list = <BSPC DEL DOT COMMA PLUS MINUS STAR FSLH EQUAL>;
            ignore-numbers;
        };

        /* App switcher (urob/zmk-tri-state): tap = mod+Tab and the mod STAYS
         * HELD; more taps cycle; any non-ignored key press (or releasing the
         * Control layer) drops the mod and commits. OS-aware since 2026-07-08:
         * &swapper is a switch-layout-key wrapping two tri-states — ⌘ on mac,
         * Alt on PC — following the same persisted &sw_layout OS_NEXT toggle
         * as every slk_* key (ZMK has no host-OS auto-detection; zmk#2553).
         * Ignored positions = Control's Tab/⇧Tab/arrows/Enter (20 21 22 /
         * 31-34) so the app grid can be navigated mid-swap, plus 11 = the
         * dedicated reverse key (⇧Tab, right of num_word): shift applies to
         * whichever mod the swapper holds, so one reverse key serves both
         * OSes. */
        swapper_mac: swapper_mac {
            compatible = "zmk,behavior-tri-state";
            label = "SWAPPER_MAC";
            #binding-cells = <0>;
            bindings = <&kt LGUI>, <&kp TAB>, <&kt LGUI>;
            ignored-key-positions = <11 20 21 22 31 32 33 34>;
        };

        swapper_win: swapper_win {
            compatible = "zmk,behavior-tri-state";
            label = "SWAPPER_WIN";
            #binding-cells = <0>;
            bindings = <&kt LALT>, <&kp TAB>, <&kt LALT>;
            ignored-key-positions = <11 20 21 22 31 32 33 34>;
        };

        swapper: swapper {
            compatible = "zmk-switch-layout,behavior-switch-layout-key";
            #binding-cells = <0>;
            bindings = <&swapper_win>, <&swapper_mac>;
        };

        as_ht: as_ht {
            compatible = "zmk,behavior-hold-tap";
            label = "AS_HT";
            bindings = <&shift>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        bdel: bdel {
            compatible = "zmk,behavior-mod-morph";
            label = "BDEL";
            bindings = <&kp BSPC>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LCTL|MOD_LALT|MOD_RCTL|MOD_LGUI|MOD_RALT|MOD_RGUI)>;
        };

        th_r_rep: th_r_rep {
            compatible = "zmk,behavior-hold-tap";
            label = "TH_R_REP";
            bindings = <&kp>, <&key_repeat>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "hold-preferred";
            quick-tap-ms = <150>;
            require-prior-idle-ms = <165>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 58 59 60 64 65 66>;
        };

        hm_r_ctrl: hm_r_ctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_R_CTRL";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 58 59 60 64 65 66>;
        };

        hm_r_gui: hm_r_gui {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_R_GUI";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 58 59 60 64 65 66>;
        };

        hm_r_shift: hm_r_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_R_SHIFT";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 51 52 58 59 60 64 65 66>;
        };

        sl_mo: sl_mo {
            compatible = "zmk,behavior-hold-tap";
            label = "SL_MO";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
        };

        leader: leader {
            compatible = "zmk,behavior-leader-key";
            label = "LEADER";
            #binding-cells = <0>;

            email {
                sequence = <E M>;
                bindings = <&email_um>;
            };

            to_usb {
                sequence = <U>;
                bindings = <&out OUT_USB>;
            };

            to_ble {
                sequence = <B>;
                bindings = <&out OUT_BLE>;
            };
        };

        /* --- OS-aware shortcuts (zmk-switch-layout): index 0 = PC, 1 = mac.
         * Persisted in settings; swap with &sw_layout OS_NEXT. --- */
        sw_layout: sw_layout {
            compatible = "zmk-switch-layout,behavior-switch-layout-mode";
            #binding-cells = <1>;
            layout-count = <2>;
            default-layout = <OS_PC>;
        };

        slk_copycut: slk_copycut {
            compatible = "zmk-switch-layout,behavior-switch-layout-key";
            #binding-cells = <0>;
            bindings = <&mt LC(X) LC(C)>, <&mt LG(X) LG(C)>;
        };

        slk_paste: slk_paste {
            compatible = "zmk-switch-layout,behavior-switch-layout-key";
            #binding-cells = <0>;
            bindings = <&kp LC(V)>, <&kp LG(V)>;
        };

        slk_undoredo: slk_undoredo {
            compatible = "zmk-switch-layout,behavior-switch-layout-key";
            #binding-cells = <0>;
            bindings = <&mt LC(Y) LC(Z)>, <&mt LG(LS(Z)) LG(Z)>;
        };

        slk_selall: slk_selall {
            compatible = "zmk-switch-layout,behavior-switch-layout-key";
            #binding-cells = <0>;
            bindings = <&kp LC(A)>, <&kp LG(A)>;
        };

        slk_close: slk_close {
            compatible = "zmk-switch-layout,behavior-switch-layout-key";
            #binding-cells = <0>;
            bindings = <&kp LC(W)>, <&kp LG(W)>;
        };

        slk_ntab: slk_ntab {
            compatible = "zmk-switch-layout,behavior-switch-layout-key";
            #binding-cells = <0>;
            bindings = <&kp LC(T)>, <&kp LG(T)>;
        };

        slk_wbspc: slk_wbspc {
            compatible = "zmk-switch-layout,behavior-switch-layout-key";
            #binding-cells = <0>;
            bindings = <&kp LC(BSPC)>, <&kp LA(BSPC)>;
        };

        slk_wdel: slk_wdel {
            compatible = "zmk-switch-layout,behavior-switch-layout-key";
            #binding-cells = <0>;
            bindings = <&kp LC(DEL)>, <&kp LA(DEL)>;
        };

        slk_home_down: slk_home_down {
            compatible = "zmk-switch-layout,behavior-switch-layout-key";
            #binding-cells = <0>;
            bindings = <&mt HOME DOWN_ARROW>, <&mt LG(LEFT) DOWN_ARROW>;
        };

        slk_end_up: slk_end_up {
            compatible = "zmk-switch-layout,behavior-switch-layout-key";
            #binding-cells = <0>;
            bindings = <&mt END UP>, <&mt LG(RIGHT) UP>;
        };

        slk_wleft: slk_wleft {
            compatible = "zmk-switch-layout,behavior-switch-layout-key";
            #binding-cells = <0>;
            bindings = <&mt LC(LEFT) LEFT_ARROW>, <&mt LA(LEFT) LEFT_ARROW>;
        };

        slk_wright: slk_wright {
            compatible = "zmk-switch-layout,behavior-switch-layout-key";
            #binding-cells = <0>;
            bindings = <&mt LC(RIGHT) RIGHT>, <&mt LA(RIGHT) RIGHT>;
        };

        /* Runtime macros (flask_macros, channel 0x25): &fmac <slot> plays a
         * live-editable 16-step macro slot (0-15), edited from the Flask
         * app. Unbound by default — assign from Studio / the app's editor;
         * the node existing is what compiles the behavior in and puts it on
         * Studio's behavior list (slot range rides parameter metadata). */
        /* Runtime leader (flask_leader, channel 0x19): &fled opens a
         * capture matched against the app-edited sequence table. Unbound
         * by default — assign from Studio / the app. urob's &leader (the
         * compiled email/USB/BLE sequences) stays on its own key. */
        fled: fled {
            compatible = "zmk,behavior-flask-leader";
            #binding-cells = <0>;
            display-name = "Flask Leader";
        };

        fmac: fmac {
            compatible = "zmk,behavior-flask-macros";
            #binding-cells = <1>;
            display-name = "Flask Macro";
        };

        /* Runtime tap dance (flask_tapdance, channel 0x28, v14): &ftd <slot>
         * runs a live-editable dance — per-slot tapping term + one typed
         * output per tap count, all from the app's wizard. Unbound by
         * default — assign from Studio / the app; the node existing is what
         * compiles the behavior in (slot range rides parameter metadata). */
        ftd: ftd {
            compatible = "zmk,behavior-flask-tapdance";
            #binding-cells = <1>;
            display-name = "Tap Dance";
        };

        /* Composer tap-hold timing variants (v14, AJ's "behavior
         * modification settings" ask). Core hold-tap params are const DT —
         * not runtime-tunable — so the app's Tap-hold section offers a
         * TIMING choice among these precompiled instances instead: &mt
         * stays the core 200 ms (quick-tap 150 via the &mt override up
         * top), fast resolves at 150, slow at 300. Same two-param shape
         * Studio already renders for &mt. */
        mt_fast: mt_fast {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Mod-Tap (fast 150)";
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        mt_slow: mt_slow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Mod-Tap (slow 300)";
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
        };

        lt_fast: lt_fast {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Layer-Tap (fast 150)";
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <125>;
            bindings = <&mo>, <&kp>;
        };

        lt_slow: lt_slow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Layer-Tap (slow 300)";
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };

        /* --- Smart one-shot/hold (2026-07-10, AJ's ask) ---
         * Tri-state modifier/layer keys by composition: a hold-tap whose
         * HOLD binding is a sticky behavior.
         *   tap                                → the tap binding (any usage)
         *   hold past tapping-term, release
         *     with nothing else pressed        → ONE-SHOT (next key gets it)
         *   keep holding and type              → plain held modifier/layer
         * The one-shot window is skm's release-after-ms (1.5 s). Unbound by
         * default — Studio-assignable two-param behaviors, the same shape
         * Studio renders for &mt / &lt (param1 = mod / layer, param2 = tap
         * usage). */
        skm: skm {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            display-name = "Sticky Mod (smart)";
            release-after-ms = <1500>;
            bindings = <&kp>;
            ignore-modifiers; /* chain ⇧ then ⌘ as stacked one-shots */
        };

        smart_mod: smart_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Smart Mod";
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&skm>, <&kp>;
        };

        /* Smart Layer, reworked to AJ's bench spec (2026-07-11): the param
         * is a LAYER on both sides —
         *   tap                  → &tog latches the layer (tap again on a
         *                          position that stays &trans to unlatch)
         *   brief hold + release → one-shot layer (next key), via &skl
         *   sustained hold       → layer while held
         * &skl is a dedicated NON-lazy sticky layer: the stock &sl carried
         * urob's `lazy` flag, which defers activation until the next key —
         * that's why the HUD didn't follow. Bind as &smart_layer L L (the
         * hold-tap needs the layer in both params; the app's composer fills
         * both from one picker). */
        skl: skl {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            display-name = "Sticky Layer (smart)";
            release-after-ms = <1500>;
            bindings = <&mo>;
            ignore-modifiers;
        };

        smart_layer: smart_layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Smart Layer";
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&skl>, <&tog>;
        };

        /* Trackball role swap (flask_ballswap, channel 0x1B, proto v11):
         * &bswap 0 = toggle + persist (survives power cycle AND reflash —
         * settings live outside the app image); &bswap 1 = swap while held.
         * Default keys: Control 41 / 42 (inner column, row 4); also
         * Studio-assignable anywhere. */
        bswap: bswap {
            compatible = "zmk,behavior-flask-ballswap";
            #binding-cells = <1>;
            display-name = "Ball Swap";
        };

    };

    /* Combos migrated to RUNTIME slots 2026-07-12 (AJ's ask: every combo
     * visible and editable in the Flask app, with its per-combo timing).
     * Same child shape as zmk,combos, but these are compiled DEFAULTS for
     * flask_combos (channel 0x24): each child seeds one runtime slot in
     * declaration order; app edits — and deletions — persist via settings
     * and win over these seeds on boot. The combos master toggle now
     * governs ALL of them (the old DT combos had no off switch). */
    flask_combos_defaults {
        compatible = "flask,combos-defaults";

        copy_cut {
            bindings = <&slk_copycut>;
            key-positions = <27 26>;
            timeout-ms = <35>;
            require-prior-idle-ms = <150>;
        };

        lbtab {
            bindings = <&kp LS(TAB)>;
            key-positions = <26 14>;
            timeout-ms = <35>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <27 15>;
            timeout-ms = <35>;
        };

        lesc {
            bindings = <&kp ESC>;
            key-positions = <13 25>;
            timeout-ms = <35>;
        };

        paste {
            bindings = <&slk_paste>;
            key-positions = <28 27>;
            timeout-ms = <35>;
            require-prior-idle-ms = <150>;
        };

        undo_redo {
            bindings = <&slk_undoredo>;
            key-positions = <26 25>;
            timeout-ms = <35>;
            require-prior-idle-ms = <150>;
        };

        sel_all {
            bindings = <&slk_selall>;
            key-positions = <29 17>;
            timeout-ms = <35>;
            require-prior-idle-ms = <140>;
        };

        ent {
            bindings = <&kp ENTER>;
            key-positions = <16 28>;
            timeout-ms = <35>;
        };

        close {
            bindings = <&slk_close>;
            key-positions = <28 40>;
            timeout-ms = <35>;
        };

        ntab {
            bindings = <&slk_ntab>;
            key-positions = <27 39>;
            timeout-ms = <35>;
        };

        quit {
            bindings = <&kp LG(Q)>;
            key-positions = <25 37>;
            timeout-ms = <35>;
        };

        rbtab {
            bindings = <&kp LS(TAB)>;
            key-positions = <21 33>;
            timeout-ms = <35>;
        };

        rtab {
            bindings = <&kp TAB>;
            key-positions = <20 32>;
            timeout-ms = <35>;
        };

        resc {
            bindings = <&kp ESC>;
            key-positions = <22 34>;
            timeout-ms = <35>;
        };

        rent {
            bindings = <&kp ENTER>;
            key-positions = <19 31>;
            timeout-ms = <35>;
        };

        excl {
            bindings = <&kp EXCL>;
            key-positions = <18 19>;
            timeout-ms = <35>;
            layers = <0>;
        };

        dot {
            bindings = <&kp DOT>;
            key-positions = <30 31>;
            timeout-ms = <35>;
        };

        comma {
            bindings = <&kp COMMA>;
            key-positions = <42 43>;
            timeout-ms = <35>;
        };

        semi {
            bindings = <&kp SEMI>;
            key-positions = <42 30>;
            timeout-ms = <35>;
        };

        quote {
            bindings = <&kp SQT>;
            key-positions = <32 44>;
            timeout-ms = <35>;
        };

        fslhq {
            bindings = <&kp FSLH>;
            key-positions = <31 43>;
            timeout-ms = <35>;
        };

        lbkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <33 45>;
            timeout-ms = <35>;
        };

        rbkt {
            bindings = <&kp RBKT>;
            key-positions = <34 46>;
            timeout-ms = <35>;
        };

        m4 {
            bindings = <&mkp MB4>;
            key-positions = <51 50>;
            timeout-ms = <35>;
        };

        m5 {
            bindings = <&mkp MB5>;
            key-positions = <52 51>;
            timeout-ms = <35>;
        };

        z {
            bindings = <&lt 1 Z>;
            key-positions = <58 64>;
            timeout-ms = <50>;
        };

        x {
            bindings = <&lt 2 X>;
            key-positions = <59 65>;
            timeout-ms = <35>;
        };

        rrep {
            bindings = <&key_repeat>;
            key-positions = <63 69>;
            timeout-ms = <35>;
        };
    };

    macros {
        shift: shift {
            compatible = "zmk,behavior-macro-one-param";
            label = "SHIFT";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_release>,
                <&kp LSHFT>;
        };

        as: as {
            compatible = "zmk,behavior-macro-one-param";
            label = "AS";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>;
        };

        /* The rgb_ug mod-hold color macros (ctrl/alt/gui/shft_rgb) and the
         * per-layer color listeners (rgb_cont/rgb_fn) were removed
         * 2026-07-09 — flask_rgb's per-key per-layer map replaces them
         * (paint layer colors in the Flask app; RGB_UNDERGLOW is off).
         * Mod-hold color feedback is a candidate flask_rgb v2 overlay. */

        qu: qu {
            compatible = "zmk,behavior-macro";
            label = "QU";
            #binding-cells = <0>;
            bindings = <&kp Q &kp U>;
        };

        email_um: email_um {
            compatible = "zmk,behavior-macro";
            label = "EMAIL_UM";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&kp C &kp H &kp O &kp W &kp D &kp N1 &kp N9 &kp N8 &kp AT &kp U &kp M &kp N &kp DOT &kp E &kp D &kp U>;
        };
    };

    /* flask_rgb: runtime per-key per-layer RGB (Flask channel 0x21). Both
     * halves compile this node; the peripheral's global LED offset comes
     * from build.yaml (CONFIG_ZMK_FLASK_RGB_LED_OFFSET=35). led-count /
     * total-leds assume AJ's 70 = whole-board count (35 per half) — if the
     * bench paint-sweep says 70 per half, bump these + the offset. */
    flask_rgb: flask_rgb {
        compatible = "flask,rgb";
        led-strip = <&led_strip>;
        led-count = <35>;
        total-leds = <70>;
        layers = <10>;
        /* LED index → keymap position (per-half chains run in per-half
         * position order; keymap positions interleave halves per row:
         * 12/12/12/12/10/6/6). Entry i = the position LED i lights. Feeds
         * the reactive-overlay API (leader candidate lighting). Same
         * assumption as flask-web's ledKeyOrder — if the bench paint sweep
         * disagrees, fix the chain order HERE and there. */
        key-positions = <
             0  1  2  3  4  5   12 13 14 15 16 17
            24 25 26 27 28 29   36 37 38 39 40 41
            48 49 50 51 52      58 59 60   64 65 66
             6  7  8  9 10 11   18 19 20 21 22 23
            30 31 32 33 34 35   42 43 44 45 46 47
            53 54 55 56 57      61 62 63   67 68 69
        >;
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&trans  &as N1   &as N2   &as N3   &as N4              &as N5                              &as N6    &as N7                   &as N8               &as N9                   &as N0               &trans
&trans  &kp Q    &kp W    &kp E    &kp R               &kp T                               &kp Y     &kp U                    &kp I                &kp O                    &kp P                &trans
&trans  &kp A    &kp S    &kp D    &kp F               &kp G                               &kp H     &kp J                    &kp K                &kp L                    &kp SEMI             &kp SQT
&trans  &kp Z    &kp X    &kp C    &kp V               &kp B                               &kp N     &kp M                    &kp COMMA            &kp DOT                  &kp FSLH             &kp LS(RPAR)
&studio_unlock  &kp F20  &kp F11  &kp F12  &kp GRAVE                                                 &slk_home_down           &slk_end_up          &slk_wleft               &slk_wright          &trans
                                   &hm_l_gui LGUI H    &hm_l_shft LSHFT SPACE  &mkp MB1    &mkp MB1  &hm_r_shift RSHFT SPACE  &hm_r_gui RGUI L
                                   &hm_l_shft LCTRL T  &hm_l_ctrl LCTRL BSPC   &mkp MB2    &mkp MB3  &hm_r_ctrl RCTRL DEL     &hm_r_shift RSHFT R
            >;
        };

        control {
            bindings = <
&bootloader  &trans        &trans    &trans        &trans     &trans                        &trans          &asc ASC_UP     &asc ASC_DOWN    &swapper         &num_word L_NUM  &kp LS(TAB)
&trans       &kp C_VOL_UP  &kp HOME  &kp UP        &kp END    &trans                        &trans          &ak_alt         &kp LS(TAB)      &kp UP           &kp TAB          &trans
&trans       &kp C_VOL_DN  &kp LEFT  &kp DOWN      &kp RIGHT  &leader                       &caps_word      &kp RET         &kp LEFT         &kp DOWN         &kp RIGHT        &kp ESC
&trans       &kp C_MUTE    &kp C_PP  &kp C_REWIND  &kp C_FF   &bswap 0                      &bswap 1        &frgb FRGB_ON   &frgb FRGB_OFF   &frgb FRGB_TOG   &ext_power EP_TOG  &to L_BASE
&trans       &trans        &trans    &trans        &trans                                                   &trans          &trans           &trans           &trans           &trans
                                                   &trans     &bt BT_SEL 0  &bt BT_SEL 1    &sw_layout OS_NEXT  &sys_reset  &bt BT_CLR
                                                   &trans     &bt BT_SEL 2  &bt BT_SEL 3    &studio_unlock  &trans          &trans
            >;
        };

        fn {
            bindings = <
&trans  &trans  &trans   &trans   &trans   &trans             &trans   &trans   &trans   &trans   &trans   &trans
&trans  &kp F1  &kp F2   &kp F3   &kp F4   &kp F13            &trans   &trans   &trans   &trans   &trans   &trans
&trans  &kp F5  &kp F6   &kp F7   &kp F8   &kp F14            &kp F16  &kp F17  &kp F18  &kp F19  &kp F20  &trans
&trans  &kp F9  &kp F10  &kp F11  &kp F12  &kp F15            &kp F21  &kp F22  &kp F23  &kp F24  &none    &trans
&none   &trans  &trans   &trans   &trans                               &trans   &trans   &trans   &trans   &trans
                                  &trans   &trans   &none     &trans   &trans   &trans
                                  &trans   &trans   &trans    &trans   &trans   &trans
            >;
        };

        /* Auto-mouse overlay (Flask MBO): popped by cursor-ball motion via
         * flask_automouse (v13 — runtime timeout/threshold/extend; default
         * 750 ms, timeout 0 latches until a transparent key). Home-row
         * clicks on both hands; hold A-position for snipe, hold S-position
         * for mouse gestures. Thumb MB1/2/3 stay via &trans. */
        mouse {
            bindings = <
&trans  &trans       &trans          &trans    &trans    &trans      &trans    &trans    &trans    &trans  &trans  &trans
&trans  &trans       &trans          &trans    &trans    &trans      &trans    &trans    &trans    &trans  &trans  &trans
&trans  &mo L_SNIPE  &fges 255  &mkp MB2  &mkp MB1  &mkp MB3    &mkp MB3  &mkp MB1  &mkp MB2  &trans  &trans  &trans
&trans  &trans       &trans          &trans    &trans    &trans      &trans    &trans    &trans    &trans  &trans  &trans
&trans  &trans       &trans          &trans    &trans                          &trans    &trans    &trans  &trans  &trans
                                               &trans    &trans    &trans    &trans    &trans    &trans
                                               &trans    &trans    &trans    &trans    &trans    &trans
            >;
        };

        /* Snipe: transparent — exists to gate the 1/3 cursor scaler in the
         * peripheral listener (Flask sniper). */
        snipe {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        /* Smart-num layer — latched by &num_word (auto-layer). Right-hand
         * numpad on the home block, operators on the outer column; digits +
         * the num_word continue-list keep it alive, anything else exits. */
        num {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans   &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp N7  &kp N8   &kp N9  &kp FSLH   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp N4  &kp N5   &kp N6  &kp STAR   &kp MINUS
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp N1  &kp N2   &kp N3  &kp PLUS   &kp EQUAL
&trans  &trans  &trans  &trans  &trans                    &kp N0  &kp DOT  &kp COMMA  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        /* Blank spares (2026-07-08): ZMK's total layer capacity is the
         * compiled devicetree child count — Studio's add-layer only reuses
         * slots freed by remove-layer. Four all-&trans spares raise the
         * ceiling to 10 for live editing (rename/fill in the editor, or
         * remove to bank the slot for later adds). Same pattern as the
         * Adept's blank Vial spares. Nothing in firmware references these. */
        spare1 { bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
        >; };

        spare2 { bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
        >; };

        spare3 { bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
        >; };

        spare4 { bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
        >; };

    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};

/* Auto-mouse layer = flask_automouse since proto v13 (replaced
 * &zip_temp_layer): runtime threshold/timeout/extend from the app's Mouse
 * tab, and timeout 0 latches the layer until a transparent key is pressed
 * (which is swallowed). Defaults mirror AJ's ask: 750 ms, extend on
 * non-transparent keys, trigger on any motion (threshold 0). The 150 ms
 * idle gate matches HRM require-prior-idle. Excluded positions = ONLY the
 * always-on thumb mouse buttons (60 61 66 67), which are transparent ON
 * the Mouse layer but must read as "still mousing"; the old zip list's
 * mouse-layer snipe/gesture/click keys (25-32) are covered by the module's
 * binding check — non-transparent keys on the layer extend, not drop. */
&flask_automouse {
    layer = <L_MOUSE>;
    timeout-ms = <750>;
    threshold = <0>;
    require-prior-idle-ms = <150>;
    excluded-positions = <60 61 66 67>;
};

/* Mouse gestures (flask_gestures, channel 0x11, proto v10 — replaced
 * kot149/zmk-mouse-gesture): hold the gesture key (Mouse layer S-position,
 * &fges 255 = follow the app's active set) and stroke EITHER ball. The
 * QMK set model is back: 8 runtime sets x 8 directions, live-editable
 * from the app's Gestures tab; sets 0-3 seed the Adept/Svalboard defaults
 * (arrows / editing / media / tab-nav — the stroke-count emulation the
 * kot149 patterns used is gone, switch sets in the app instead). Ratchet
 * step defaults to 150 (the benched stroke feel); motion is swallowed
 * while a gesture is open. */

/* Flask accel (proto v9, channel 0x10) — the QMK pd_accel sigmoid, runtime-
 * tunable from the app's Acceleration card. Boots DISABLED (matches AJ's
 * live Svalboard dump: accel off in real use) — the GUI toggle enables it
 * live and SAVE persists. Replaced the maslov &pointer_accel experiment
 * (DT-const, no GUI path). CPI matches the right ball's 1600. */
&flask_accel {
    cpi = <1600>;
    start-disabled;
};

/* Trackball role swap (flask_ballswap, proto v11): one processor fronts
 * each ball's physical chain, right after gestures (gestures must always
 * see raw counts, swap or no swap). While a swap is in effect the
 * processor swallows motion and re-emits it from its own node; the
 * bswap_*_out listeners below carry the OTHER role's chain. Swap off =
 * pass-through, the compiled chains run untouched. */
/ {
    bswap_right: bswap_right {
        compatible = "zmk,input-processor-flask-ballswap";
        #input-processor-cells = <0>;
    };

    bswap_left: bswap_left {
        compatible = "zmk,input-processor-flask-ballswap";
        #input-processor-cells = <0>;
    };
};

/* Right ball = cursor. Gestures see raw counts first (matches the Flask
 * pipeline order); accel scales in place before the unit scaler; motion
 * pops the auto-mouse layer via flask_automouse (runtime-tunable since
 * v13 — see the node config above); snipe layer scales 1/3 on top of the
 * base chain. */
&trackball_peripheral_listener {
    input-processors = <
        &flask_gestures
        &bswap_right
        &flask_accel
        &zip_xy_scaler 1 1
        &flask_automouse
    >;

    snipe {
        layers = <L_SNIPE>;
        input-processors = <&zip_xy_scaler 1 3>;
        process-next;
    };
};

/* Swapped right ball → the SCROLL chain (a copy of the left ball's chain
 * below, minus gestures, which already ran on the physical chain).
 * Transform differs from the left chain: the halves are mirror images, so
 * the right ball needs the OPPOSITE correction — bench 2026-07-11 found
 * both axes inverted with the left chain's X-invert (X twice = none, so
 * the net fix is a Y-invert). */
/ {
    bswap_right_out_listener {
        compatible = "zmk,input-listener";
        device = <&bswap_right>;
        input-processors = <
            &zip_x_scaler 1 16
            &zip_y_scaler 1 12
            &zip_xy_to_scroll_mapper
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            &flask_scrollsnap
        >;
    };
};

/* BLE mouse host (tadakado/zmk-ble-mouse-host) REMOVED 2026-07-12 (AJ's
 * bench-3 ask) — it held a second central-role connection that kept
 * muddying the rgb split-link diagnosis. Re-adding = west.yml project +
 * this node block + pair/unpair behaviors + Control 17/18 bindings. */

/* Left ball = scroll, the stock ZMK chain (the Flask rate-capped converter
 * was tried and removed 2026-07-08 — AJ prefers this feel). Autoscroll is
 * NOT in this chain: stepped mode emits wheel ticks from its own node and
 * never intercepts ball motion (jog mode, which needed to swallow motion,
 * was removed 2026-07-08). Snap/lock at the end is flask_scrollsnap since
 * proto v9 — same engine as kot149's zip_scroll_snap it replaced, but every
 * knob is live from the app's Scroll snap card. */
&trackball_central_listener {
    input-processors = <
        &flask_gestures
        &bswap_left
        &zip_x_scaler 1 16
        &zip_y_scaler 1 12
        &zip_xy_to_scroll_mapper
        &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
        &flask_scrollsnap
    >;
};

/* Swapped left ball → the CURSOR chain (a copy of the right ball's chain
 * above, minus gestures; auto-mouse and the snipe scaler come along so a
 * swapped left ball behaves exactly like the right one did). The XY invert
 * up front mirrors the left sensor's orientation onto the right ball's
 * frame (bench 2026-07-11: both axes inverted without it). */
/ {
    bswap_left_out_listener {
        compatible = "zmk,input-listener";
        device = <&bswap_left>;
        input-processors = <
            &zip_xy_transform (INPUT_TRANSFORM_X_INVERT | INPUT_TRANSFORM_Y_INVERT)
            &flask_accel
            &zip_xy_scaler 1 1
            &flask_automouse
        >;

        snipe {
            layers = <L_SNIPE>;
            input-processors = <&zip_xy_scaler 1 3>;
            process-next;
        };
    };
};

/* Autoscroll (flask port, Ben White stepped intervals). Wheel ticks are ±1
 * already paced by the interval, so no snap/cap needed on the way out.
 * Keys: control layer &asc ASC_UP / ASC_DOWN (Studio-movable). */
&flask_autoscroll {
    speed-scale = <100>;
};

/ {
    flask_autoscroll_out {
        compatible = "zmk,input-listener";
        device = <&flask_autoscroll>;
    };
};
